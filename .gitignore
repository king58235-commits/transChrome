# Python
__pycache__/
*.pyc
backend/venv/

# Benchmark outputs: raw per-sentence JSON and test audio (real livestream
# content, copyright concerns) stay local — only scripts, the dataset script
# and the .md summary reports are tracked (see README).
backend/benchmark/*.wav
backend/benchmark/*.json
backend/benchmark/*.log

# Session audio saved by SAVE_SESSION_AUDIO (stream audio, stays local)
backend/recordings/

# Backend console logs written by LOG_TO_FILE (contain live transcripts)
backend/logs/
